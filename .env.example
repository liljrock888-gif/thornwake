# Copy these names into Vercel: Project → Settings → Environment Variables.
# Never commit real values to git.

# Stripe → Developers → API keys. Start with the test key (sk_test_...).
STRIPE_SECRET_KEY=

# Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Upstash → your Redis database → REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The public address of your site, e.g. https://thornwake.vercel.app
SITE_URL=

# Lets the webhook read Stripe's raw request body. Keep this set to 0.
NODEJS_HELPERS=0

# Supabase → Project Settings → API. The anon key is public by design; the database's
# row-level security (supabase/setup.sql) keeps each player's save private.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: a Discord webhook that gets a message whenever someone buys something
# or gets a refund. Discord → channel settings → Integrations → Webhooks →
# New Webhook → Copy Webhook URL. Leave empty to skip Discord notifications.
DISCORD_WEBHOOK_URL=
